<Window x:Class="Videoficha.Views.SystemInfoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Información del Sistema" SizeToContent="Height" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Modelo:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="ModelTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <Label Content="Sistema Operativo:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="OSTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <Label Content="Procesador:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="ProcessorTextBox" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <Label Content="RAM (GB):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="RAMTextBox" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <Label Content="Almacenamiento (GB):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="StorageTextBox" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <Label Content="Tarjeta Gráfica:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="GraphicsTextBox" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <Button Content="Guardar" Click="SaveButton_Click" 
                Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right" Margin="5"
                Width="100" Height="30" Background="#0292D8" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>
