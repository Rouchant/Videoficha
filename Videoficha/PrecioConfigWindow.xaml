<Window x:Class="Videoficha.PrecioConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Precios" SizeToContent="Height" Width="400" Background="#f0f0f0">
    <Window.Resources>
        <Style x:Key="CustomToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="Green"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="DarkGreen"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="LightGray"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="Gray"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Configuración de Precios" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" />

        <TextBlock Text="Precio Normal:" Margin="0,10" />
        <TextBox x:Name="PrecioNormalTextBox" Width="200" Margin="0,10" />

        <TextBlock Text="Precio Oferta:" Margin="0,10" />
        <TextBox x:Name="PrecioOfertaTextBox" Width="200" Margin="0,10" />

        <TextBlock Text="Precio Exclusivo Tarjeta:" Margin="0,10" />
        <TextBox x:Name="PrecioExclusivoTarjetaTextBox" Width="200" Margin="0,10" />

        <TextBlock Text="Mostrar Precio:" Margin="0,10" />
        <ToggleButton x:Name="MostrarPrecioToggleButton" Margin="0,10" Width="40" Height="40" HorizontalAlignment="center" VerticalAlignment="Center" Content="" 
                      Style="{StaticResource CustomToggleButtonStyle}" Checked="MostrarPrecioToggleButton_Checked" Unchecked="MostrarPrecioToggleButton_Unchecked" />

        <TextBlock Text="Modo de Visualización de Precios:" Margin="0,10" />
        <ComboBox x:Name="PrecioDisplayModeComboBox" Width="200" Margin="0,10">
            <ComboBoxItem Content="Precio Normal y Precio Oferta" />
            <ComboBoxItem Content="Precio Normal, Precio Oferta, Precio Exclusivo Tarjeta" />
        </ComboBox>

        <Button Content="Guardar" Click="SaveButton_Click" Width="100" Margin="20,20,0,0" HorizontalAlignment="Right" />
    </StackPanel>
</Window>