<Window x:Class="Videoficha.LeerFicha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Leer Ficha" 
        Background="#f0f0f0" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Border MouseDown="Border_MouseDown" Background="Transparent">
            <TextBlock Text="Ficha del equipo" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10" 
                       HorizontalAlignment="Center" 
                       Foreground="#333" />
        </Border>

        <!-- Control WebView2 para PDF -->
        <wpf:WebView2 Name="pdfWebView" Grid.Row="1" />
        
        <Button Content="Cerrar" 
                Grid.Row="2" 
                HorizontalAlignment="Center" 
                FontWeight="Bold" 
                BorderBrush="Transparent" 
                Foreground="White"
                FontSize="16"
                Cursor="Hand"
                Margin="5"
                Background="#0292D8"
                Padding="20 15"
                Click="CloseButton_Click" />
    </Grid>
</Window>