<Window x:Class="Videoficha.Features.SystemDiagnostics.Views.SystemInfoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Especificaciones" SizeToContent="Height" Width="450" 
        Background="#121212" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="EDITAR ESPECIFICACIONES" Foreground="#0292D8" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Modelo" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.Model, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <TextBlock Text="Procesador" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.Processor, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <TextBlock Text="Memoria RAM" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.RAM, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <TextBlock Text="Almacenamiento" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.Storage, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <TextBlock Text="Pantalla" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.Display, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <TextBlock Text="Gráficos" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.Graphics, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <TextBlock Text="Sistema" Foreground="#888" Margin="0,10,0,5"/>
            <TextBox Text="{Binding SystemSpec.OS, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#333" Padding="5"/>

            <Button Content="GUARDAR CAMBIOS" Click="SaveButton_Click" Margin="0,30,0,0" Padding="10" Background="#0292D8" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
