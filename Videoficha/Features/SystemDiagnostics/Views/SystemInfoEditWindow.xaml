<ContentDialog x:Class="Videoficha.Features.SystemDiagnostics.Views.SystemInfoEditWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               Title="Editar Especificaciones"
               PrimaryButtonText="GUARDAR CAMBIOS"
               CloseButtonText="CANCELAR"
               PrimaryButtonClick="SaveButton_Click"
               DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="RestoreButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="↺"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="#0292D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </ContentDialog.Resources>
    
    <Grid Margin="10" Width="400">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="EDITAR ESPECIFICACIONES" Foreground="#0292D8" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Modelo" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Model, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="Model" Click="RestoreButton_Click"/>
                </Grid>

                <TextBlock Text="Procesador" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Processor, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="Processor" Click="RestoreButton_Click"/>
                </Grid>

                <TextBlock Text="Memoria RAM" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding RAM, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="RAM" Click="RestoreButton_Click"/>
                </Grid>

                <TextBlock Text="Almacenamiento" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Storage, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="Storage" Click="RestoreButton_Click"/>
                </Grid>

                <TextBlock Text="Pantalla" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Display, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="Display" Click="RestoreButton_Click"/>
                </Grid>

                <TextBlock Text="Gráficos" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Graphics, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="Graphics" Click="RestoreButton_Click"/>
                </Grid>

                <TextBlock Text="Sistema" Foreground="#888" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OS, Mode=TwoWay}" Background="#1E1E1E" Foreground="White" BorderBrush="#333"/>
                    <Button Grid.Column="1" Style="{StaticResource RestoreButtonStyle}" Tag="OS" Click="RestoreButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
