<Window x:Class="Videoficha.Features.Kiosk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="using:Videoficha.Shared"
        mc:Ignorable="d"
        Title="Videoficha">

    <Grid Background="#080808" PointerMoved="OnPointerMoved" KeyDown="OnKeyDown">
        <Grid.Resources>
            <shared:BoolToVisibilityConverter x:Key="BoolToVis" />
            <shared:BoolToStrikethroughConverter x:Key="BoolToStrike" />
            
            <Style x:Key="SpecCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF"/> <!-- Glass effect -->
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Padding" Value="15,10"/>
                <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="CardIconStyle" TargetType="Image">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="10,0,15,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="CardLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#AAA"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Style>

            <Style x:Key="CardValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>

        <!-- Fondo con gradiente para mejorar legibilidad sobre el video -->
        <MediaPlayerElement x:Name="backgroundView" AreTransportControlsEnabled="False" Opacity="0.25" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#CC080808" Offset="0"/>
                    <GradientStop Color="#33080808" Offset="0.5"/>
                    <GradientStop Color="#CC080808" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="MainContentGrid" Margin="50,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Source="{Binding ManufacturerLogo}" Height="50" Width="120" Margin="0,0,25,0" Stretch="Uniform"/>
                    <Image Source="{Binding DistributorLogo}" Height="50" Width="120" Stretch="Uniform" Opacity="0.8"
                           Visibility="{Binding Settings.ShowDistributorLogo, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemSpec.Model}" Foreground="White" FontSize="28" FontWeight="ExtraBold" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Settings.SKU}" Foreground="#888" FontSize="13" FontWeight="Bold" TextAlignment="Right" 
                               Visibility="{Binding Settings.ShowSKU, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- BODY -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/> <!-- Columna fija pero ajustada -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Style="{StaticResource SpecCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding CpuVendorIcon}" Style="{StaticResource CardIconStyle}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PROCESADOR" Style="{StaticResource CardLabelStyle}"/><TextBlock Text="{Binding SystemSpec.Processor}" Style="{StaticResource CardValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SpecCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/Images/ui/ram.png" Style="{StaticResource CardIconStyle}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MEMORIA RAM" Style="{StaticResource CardLabelStyle}"/><TextBlock Text="{Binding SystemSpec.RAM}" Style="{StaticResource CardValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SpecCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/Images/ui/storage.png" Style="{StaticResource CardIconStyle}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource CardLabelStyle}"/><TextBlock Text="{Binding SystemSpec.Storage}" Style="{StaticResource CardValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SpecCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/Images/ui/screen.png" Style="{StaticResource CardIconStyle}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PANTALLA" Style="{StaticResource CardLabelStyle}"/><TextBlock Text="{Binding SystemSpec.Display}" Style="{StaticResource CardValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SpecCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/Images/ui/gpu.png" Style="{StaticResource CardIconStyle}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GRÁFICOS" Style="{StaticResource CardLabelStyle}"/><TextBlock Text="{Binding SystemSpec.Graphics}" Style="{StaticResource CardValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SpecCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/Images/ui/windows-11.png" Style="{StaticResource CardIconStyle}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SISTEMA OPERATIVO" Style="{StaticResource CardLabelStyle}"/><TextBlock Text="{Binding SystemSpec.OS}" Style="{StaticResource CardValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Viewbox Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center" Stretch="Uniform">
                    <Grid Width="1600" Height="900">
                        <Border CornerRadius="0">
                            <MediaPlayerElement x:Name="videoView" AreTransportControlsEnabled="False" />
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- FOOTER -->
            <Grid Grid.Row="2" Margin="0,40,0,0">
                <Button HorizontalAlignment="Left" Width="240" Height="80" Background="{Binding Settings.AccentColor}" BorderThickness="0" CornerRadius="0" Click="Explore_Click">
                    <TextBlock Text="{Binding Settings.CTAText}" Foreground="Black" FontSize="22" FontWeight="ExtraBold"/>
                </Button>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding Settings.ShowPrice, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Settings.ListPrice}" Foreground="#AAA" FontSize="28" FontWeight="Bold" TextAlignment="Right"
                               TextDecorations="{Binding Settings.StrikethroughListPrice, Converter={StaticResource BoolToStrike}}"/>
                    <TextBlock Text="{Binding Settings.PromoPrice}" Foreground="{Binding Settings.AccentColor}" FontSize="52" FontWeight="ExtraBold" TextAlignment="Right" Margin="0,-5,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Name="PromoGrid" Visibility="Collapsed" Background="Black" Canvas.ZIndex="999">
            <MediaPlayerElement x:Name="promoView" AreTransportControlsEnabled="False" />
        </Grid>

        <Button Name="AdminTrigger" Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" Click="AdminTrigger_Click" />
    </Grid>
</Window>
