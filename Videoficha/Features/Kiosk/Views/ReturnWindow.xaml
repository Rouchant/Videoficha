<Window x:Class="Videoficha.Features.Kiosk.Views.ReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volver">
    
    <Grid Background="Transparent">
        <Border Background="{Binding Settings.AccentColor}" CornerRadius="0" Margin="15">
            <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Return_Click">
                <TextBlock Text="VOLVER A FICHA" Foreground="Black" FontWeight="ExtraBold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Border>
    </Grid>
</Window>
