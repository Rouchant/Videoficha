<Window x:Class="Videoficha.Features.Kiosk.Views.ReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volver" Height="120" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    
    <Border Background="{Binding Settings.AccentColor}" CornerRadius="0" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Button Background="Transparent" BorderThickness="0" Click="Return_Click">
            <TextBlock Text="VOLVER A FICHA" Foreground="Black" FontWeight="ExtraBold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
    </Border>
</Window>
